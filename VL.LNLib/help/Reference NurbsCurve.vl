          <Pad Id="C1bvyJMknZjO1NR1DXn3LM" Bounds="54,77,179,37" ShowValueBox="true" isIOBox="true" Value="NurbsCurve">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">18</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="IeBlBVMXZLVLxsSrZryQGo" Bounds="54,130,398,190" ShowValueBox="true" isIOBox="true" Value="A NURBS (Non-Uniform Rational B-Spline) Curve is a mathematical model used to generate smooth, complex geometry with high precision. Unlike simple Polylines or Bezier curves, NURBS can accurately represent both free-form shapes and standard analytic geometry like circles, ellipses, and arcs using a single mathematical representation. It is defined by its Degree (smoothness), Control Points (shape influence), and Knots (how the curve flows through time/parameter space), offering a powerful standard for modeling curves in computer graphics and CAD applications.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="EqChat9KsfxL1MdxrMjpYb" Bounds="54,335,214,62" ShowValueBox="true" isIOBox="true" Value="Why ControlPoints count equals degree plus one?">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">12</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Fd7zRCx0v0AQKM7PQy2DVE" Bounds="45,771,347,104" ShowValueBox="true" isIOBox="true" Value="Adaptive Tessellation: The Tessellate method uses an adaptive recursive algorithm, meaning it automatically adds more points to sharp curves and fewer points to flat sections. This ensures high visual quality while keeping the vertex count low for rendering performance.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="OP4KgTYGR6EMMhWxarEQGH" Bounds="54,438,320,160" ShowValueBox="true" isIOBox="true" Value="Length-Based Evaluation: Besides standard parameter evaluation (GetPointOnCurve), the class provides GetPointAt and GetParamByLength. These methods allow you to traverse the curve by normalized length (0.0 to 1.0) or absolute units, which is essential for animating objects at constant speeds regardless of the curve's control point distribution.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
