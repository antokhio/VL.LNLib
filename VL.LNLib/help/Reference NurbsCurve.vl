          <Pad Id="EqChat9KsfxL1MdxrMjpYb" Bounds="47,313,214,62" ShowValueBox="true" isIOBox="true" Value="Why ControlPoints count equals degree plus one?">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">12</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Fd7zRCx0v0AQKM7PQy2DVE" Bounds="47,379,311,75" ShowValueBox="true" isIOBox="true" Value="A Bezier curve of degree N is defined by a polynomial of order N. To define the coefficients of that polynomial, you need exactly N + 1 inputs (control points).">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="M4EWzSUpSe8LgKMFXvck9Q" Bounds="47,505,214,62" ShowValueBox="true" isIOBox="true" Value="Common Confusion (Splines vs. Bezier)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">12</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="OP4KgTYGR6EMMhWxarEQGH" Bounds="47,579,347,222" ShowValueBox="true" isIOBox="true" Value="Sometimes people expect to add unlimited points (e.g., 10 points) and keep the curve &quot;smooth&quot; (Cubic/Degree 3).&#xD;&#xA;&#xD;&#xA;Single Bezier: If you have 10 points, the degree must be 9. High-degree Bezier curves can become &quot;wobbly&quot; and numerically unstable.&#xD;&#xA;Spline / Composite Bezier: To have 10 points with Degree 3, you actually need a B-Spline or a chain of multiple Bezier segments connected together. ">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
