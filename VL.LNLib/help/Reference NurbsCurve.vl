          <Pad Id="SIr6gzYGtsBOjkAkfcPMyT" Bounds="1440,566,209,89" ShowValueBox="true" isIOBox="true" Value="If you want animation consider using instead. The &quot;At&quot; versions require expensive curve normalization">
