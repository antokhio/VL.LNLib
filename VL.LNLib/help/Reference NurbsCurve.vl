          <Pad Id="DxSQutaElR4NZp9NXVS6C7" Bounds="55,621,369,123" ShowValueBox="true" isIOBox="true" Value="Robust Normal Calculation: The GetNormal implementation includes automatic fallback logic. If the standard Frenet frame calculation fails (e.g., at inflection points or straight lines where curvature is zero), it intelligently attempts alternative up-vectors to ensure a stable orientation is always returned.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="C4T8KmRIAXtLJwapSs9Oqq" Bounds="46,904,369,123" ShowValueBox="true" isIOBox="true" Value="Dual Precision Interop: While the external API uses standard Vector2/Vector3 (floats) for easy integration with rendering engines, all internal calculations and the underlying native kernel operate in double precision. This ensures that complex operations like derivatives and integration remain accurate before being cast back for display.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
